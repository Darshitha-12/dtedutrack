generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USER MODELS
// ============================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  passwordHash String
  emailVerified DateTime?
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile          Profile?
  studentProfile   StudentProfile?
  alarms           Alarm[]
  studySessions    StudySession[]
  markRecords      MarkRecord[]
  timetablePref    TimetablePref?
  timetableDays    TimetableDay[]
  plannerSessions  PlannerSession[]
  pomodoroSessions PomodoroSession[]
  workLogs         WorkLog[]
  notificationPrefs NotificationPreference?
  accounts         Account[]
  sessions         Session[]
  topicProgress    UserTopicProgress[]
  conversations    Conversation[]
  quizzes          Quiz[]
  questionAttempts QuestionAttempt[]
  notes            Note[]
  notepadEntries   NotepadEntry[]
  flashcardDecks   FlashcardDeck[]
  chatMessages     ChatMessage[]
  groupMembers     GroupMember[]
  sentMessages     DirectMessage[] @relation("DirectMessageSender")
  receivedMessages DirectMessage[] @relation("DirectMessageReceiver")
  presence         Presence?

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examDate    DateTime?
  targetGrade String   @default("A")
  revHours    Int      @default(350)
  dailyHr     Int      @default(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}

model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName         String   @default("")
  avatarUrl        String?
  language         String   @default("en")
  examYear         Int?
  examDate         DateTime?
  examType         String   @default("A/L Biology")
  dailyStudyTarget Int      @default(4)
  weeklyStudyTarget Int     @default(28)
  targetGrade      String   @default("A")
  currentLevel     String   @default("intermediate")
  preferredTime    String   @default("morning")
  weakTopics       String[]
  subjects         String[]
  onboarded        Boolean  @default(false)
  onboardedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("student_profiles")
}

// ============================================================
// SMART STUDY PLANNER (A/L Timetable) MODELS
// ============================================================

model TimetablePref {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  weeklyTargetMin    Int      @default(1800) // 0 = no target
  sessionLengthMin   Int      @default(60)
  breakAfterMin      Int      @default(60)
  breakDurationMin   Int      @default(10)
  timeFormat         String   @default("24h") // "12h" or "24h"
  subjectPriorities  Json     @default("[]") // [{subjectId,name,priority,icon,color}]
  studyTypeWeight    Json     @default("[]") // [{type,weight}]
  weakTopics         String[] @default([])
  showBreaks         Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@map("timetable_prefs")
}

model TimetableDay {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek       Int      // 0=Mon .. 6=Sun
  enabled         Boolean  @default(false)
  dailyTargetMin  Int      @default(0) // 0 = no target
  blocks          Json     @default("[]") // [{startMinute,endMinute}]
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([userId, dayOfWeek])
  @@index([userId])
  @@map("timetable_days")
}

model PlannerSession {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId       String
  subjectName     String    @default("")
  topicId         String?
  topicTitle      String?

  // Schedule placement
  date            DateTime? // for a specific date
  dayOfWeek       Int?      // 0=Mon..6=Sun for recurring schedules
  startMinute     Int
  endMinute       Int

  type            String    @default("Learn") // Learn, Revision, MCQ, PastPaper, WeakTopic, AITutor, Review
  priority        String    @default("Medium") // Low, Medium, High
  status          String    @default("scheduled") // scheduled, completed, skipped, missed
  completedAt     DateTime?

  recurrence      String    @default("Once") // Once, Daily, Weekly, SelectedWeekdays
  recurrenceDays  Int[]     @default([])
  reminderMin     Int       @default(0) // 0 = none
  notes           String    @default("")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, date])
  @@index([userId, dayOfWeek])
  @@index([userId, status])
  @@map("planner_sessions")
}

// ============================================================
// CONTENT HIERARCHY MODELS
// ============================================================

model ContentSubject {
  id          String @id
  slug        String @unique
  name        String
  nameSi      String @default("")
  description String @default("")
  descriptionSi String @default("")
  icon        String
  color       String
  order       Int    @default(0)
  status      String @default("DEMO") // DEMO, DRAFT, VERIFIED, ARCHIVED
  source      String @default("DEMO") // DEMO, OFFICIAL, TEACHER_CREATED, AI_GENERATED, USER_CREATED
  version     Int    @default(1)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units       ContentUnit[]
  questions   Question[]

  @@map("content_subjects")
}

model ContentUnit {
  id            String @id
  subjectId     String
  subject       ContentSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  slug          String
  order         Int    @default(0)
  title         String
  titleSi       String @default("")
  description   String @default("")
  descriptionSi String @default("")
  estimatedMinutes Int @default(0)
  status        String @default("DEMO")
  source        String @default("DEMO")
  version       Int    @default(1)
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topics        ContentTopic[]
  questions     Question[]

  @@unique([subjectId, slug])
  @@map("content_units")
}

model ContentTopic {
  id            String @id
  unitId        String
  unit          ContentUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slug          String
  order         Int    @default(0)
  title         String
  titleSi       String @default("")
  description   String @default("")
  descriptionSi String @default("")
  difficulty    String @default("intermediate") // beginner, intermediate, advanced
  importance    String @default("normal") // low, normal, high, critical
  examRelevance Int    @default(50) // 0-100
  estimatedMinutes Int @default(0)
  status        String @default("DEMO")
  source        String @default("DEMO")
  version       Int    @default(1)
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subtopics           ContentSubtopic[]
  learningObjectives  ContentLearningObjective[]
  userProgress        UserTopicProgress[]
  questions           Question[]

  @@unique([unitId, slug])
  @@map("content_topics")
}

model ContentSubtopic {
  id            String @id
  topicId       String
  topic         ContentTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  slug          String
  order         Int    @default(0)
  title         String
  titleSi       String @default("")
  description   String @default("")
  descriptionSi String @default("")
  content       String @default("") // markdown content
  contentSi     String @default("")
  difficulty    String @default("intermediate")
  estimatedMinutes Int @default(0)
  status        String @default("DEMO")
  source        String @default("DEMO")
  version       Int    @default(1)
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  learningObjectives  ContentLearningObjective[]

  @@unique([topicId, slug])
  @@map("content_subtopics")
}

model ContentLearningObjective {
  id            String @id
  topicId       String?
  topic         ContentTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId    String?
  subtopic      ContentSubtopic? @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  slug          String
  order         Int    @default(0)
  title         String
  titleSi       String @default("")
  description   String @default("")
  descriptionSi String @default("")
  difficulty    String @default("intermediate")
  status        String @default("DEMO")
  source        String @default("DEMO")
  version       Int    @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([topicId, subtopicId, slug])
  @@map("content_learning_objectives")
}

model ContentSource {
  id            String   @id @default(uuid())
  name          String
  type          String   // TEXTBOOK, PAST_PAPER, TEACHER_NOTE, WEBSITE, VIDEO
  url           String?
  author        String?
  publishedYear Int?
  description   String @default("")
  verified      Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("content_sources")
}

// ============================================================
// USER PROGRESS MODELS
// ============================================================

model UserTopicProgress {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId           String
  topic             ContentTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId        String?
  status            String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, REVIEW, MASTERED
  masteryScore      Float    @default(0) // 0-100
  completionPercent Float    @default(0) // 0-100
  questionsAttempted Int     @default(0)
  questionsCorrect   Int     @default(0)
  studyMinutes      Int      @default(0)
  confidence        String   @default("low") // low, medium, high
  lastStudiedAt     DateTime?
  lastReviewedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, topicId, subtopicId])
  @@index([userId, status])
  @@index([userId, topicId])
  @@map("user_topic_progress")
}

// ============================================================
// EXISTING MODELS (preserved)
// ============================================================

model Subject {
  id    String @id
  name  String
  icon  String
  color String

  alarms         Alarm[]
  studySessions  StudySession[]

  @@map("subjects")
}

model Alarm {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])

  kind            String   @default("fixed")
  time            String?
  fireAt          DateTime?
  label           String
  priority        String   @default("normal")
  sound           String   @default("chime")
  tts             Boolean  @default(true)
  days            Int[]
  enabled         Boolean  @default(true)
  fired           Boolean  @default(false)
  lastFired       DateTime?
  snoozeCount     Int      @default(0)
  reviewTopicId   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, enabled])
  @@index([userId, fireAt])
  @@map("alarms")
}

model StudySession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  minutes     Int
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, completedAt])
  @@map("study_sessions")
}

model WorkLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  minutes   Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("work_logs")
}

model PomodoroSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  phase       String
  durationMin Int
  completed   Boolean  @default(true)
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  @@index([userId, startedAt])
  @@map("pomodoro_sessions")
}

model MarkRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  score     Int?
  total     Int
  name      String   @default("")
  examDate  DateTime
  createdAt DateTime @default(now())

  @@index([userId, subjectId])
  @@map("mark_records")
}

model NotificationPreference {
  id               String @id @default(uuid())
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  browserEnabled   Boolean @default(false)
  telegramEnabled  Boolean @default(false)
  telegramToken    String  @default("")
  telegramChatId   String  @default("")
  telegramAll      Boolean @default(false)
  ntfyEnabled      Boolean @default(false)
  ntfyTopic        String  @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("notification_preferences")
}

// ============================================================
// AI TUTOR MODELS
// ============================================================

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // USER, ASSISTANT, SYSTEM
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model AIUsage {
  id           String   @id @default(uuid())
  userId       String
  provider     String   // openai, etc.
  model        String
  promptTokens Int      @default(0)
  completionTokens Int @default(0)
  totalTokens  Int      @default(0)
  durationMs   Int      @default(0)
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([provider, model])
  @@map("ai_usage")
}

// ============================================================
// QUESTION & PRACTICE ENGINE (Phase 2D)
// ============================================================

model Question {
  id          String   @id @default(uuid())
  subjectId   String
  subject     ContentSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitId      String
  unit        ContentUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topicId     String
  topic       ContentTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type        String   @default("MCQ") // MCQ, MULTIPLE_SELECT, TRUE_FALSE
  difficulty  String   @default("medium") // easy, medium, hard
  stem        String   @db.Text
  stemSi      String   @default("") @db.Text
  explanation String   @default("") @db.Text
  explanationSi String @default("") @db.Text
  marks       Int      @default(1)
  tags        String[]
  status      String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  source      String   @default("DEMO")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options      QuestionOption[]
  quizQuestions QuizQuestion[]
  attempts     QuestionAttempt[]

  @@index([topicId, difficulty])
  @@index([subjectId, unitId])
  @@index([status])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  textSi     String   @default("")
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@unique([questionId, order])
  @@map("question_options")
}

model Quiz {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String?
  mode        String    @default("PRACTICE") // PRACTICE, WEAK_TOPICS, RETRY_WRONG, MOCK
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  score       Int       @default(0)
  total       Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions QuizQuestion[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("quizzes")
}

model QuizQuestion {
  id               String   @id @default(uuid())
  quizId           String
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order            Int
  status           String   @default("PENDING") // PENDING, ANSWERED, SKIPPED
  selectedOptionId String?
  isCorrect        Boolean?
  timeMs           Int      @default(0)
  answeredAt       DateTime?

  @@unique([quizId, order])
  @@index([questionId])
  @@map("quiz_questions")
}

model QuestionAttempt {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  isCorrect        Boolean
  answeredAt       DateTime  @default(now())

  @@index([userId, questionId])
  @@index([userId, answeredAt])
  @@map("question_attempts")
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("notes")
}

model NotepadEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  content   String   @db.Text
  color     String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("notepad_entries")
}

// ============================================================
// FLASHCARDS
// ============================================================

model FlashcardDeck {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  language  String      @default("English") // English, Sinhala
  source    String      @default("AI_GENERATED") // AI_GENERATED, REGENERATED, MANUAL
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  cards Flashcard[]

  @@index([userId, createdAt])
  @@map("flashcard_decks")
}

model Flashcard {
  id        String        @id @default(uuid())
  deckId    String
  deck      FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front     String
  back      String
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([deckId, order])
  @@map("flashcards")
}

// ============================================================
// TELEGRAM GROUPS & COMMUNITY CHAT
// ============================================================

model TelegramGroup {
  id          String   @id @default(uuid())
  name        String
  username    String   @unique
  inviteLink  String   @default("")
  category    String   @default("group") // group, channel, supergroup
  description String   @default("")
  memberCount Int      @default(0)
  isOfficial  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     GroupMember[]

  @@index([category])
  @@index([name])
  @@map("telegram_groups")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      String   @default("general") // community room / study-group slug
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([room, createdAt])
  @@map("chat_messages")
}

// ============================================================
// APP CHANNELS (join & chat in-app, no Telegram account needed)
// ============================================================

model GroupChannel {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String        @default("")
  category    String        @default("study") // study, motivation, general
  isOfficial  Boolean       @default(false)
  memberCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]

  @@index([category])
  @@map("group_channels")
}

model GroupMember {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId       String?
  channel         GroupChannel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  telegramGroupId String?
  telegramGroup   TelegramGroup? @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@unique([userId, channelId, telegramGroupId])
  @@index([userId])
  @@index([channelId])
  @@index([telegramGroupId])
  @@map("group_members")
}

// ============================================================
// DIRECT MESSAGING (WhatsApp-style 1-on-1 chat)
// ============================================================

model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("DirectMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  text       String   @default("")
  mediaUrl   String?
  mediaType  String? // image, video, audio
  mediaName  String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([receiverId, readAt])
  @@map("direct_messages")
}

model Presence {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("offline") // online, offline
  lastSeen  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_presence")
}
